 "texts": [
  {"text": "July 1981. Charles and Diana", "a": 0, "b": 3.0, "y": 1170, "size": 66},
  {"text": "stepped onto the balcony.", "a": 0, "b": 3.0, "y": 1262, "size": 66},
  {"text": "Buckingham Palace, July 29, 1981", "a": 0, "b": 3.0, "y": 1350, "size": 46, "small": true},
  {"text": "The crowd below", "a": 3.0, "b": 4.9, "y": 1170, "size": 78},
  {"text": "called for a kiss.", "a": 3.0, "b": 4.9, "y": 1262, "size": 78},
  {"text": "So he kissed his bride.", "a": 4.9, "b": 7.25, "y": 1215, "size": 76},
  {"text": "The first royal kiss", "a": 7.25, "b": 10.15, "y": 1170, "size": 76},
  {"text": "on the palace balcony.", "a": 7.25, "b": 10.15, "y": 1262, "size": 76},
  {"text": "In 2011, William and Kate", "a": 10.15, "b": 13.7, "y": 1170, "size": 72},
  {"text": "kissed there twice.", "a": 10.15, "b": 13.7, "y": 1262, "size": 76},
  {"text": "Some traditions begin", "a": 13.7, "b": 99, "y": 1170, "size": 76},
