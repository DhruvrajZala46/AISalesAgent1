 "texts": [
  {
   "text": "Diana’s revenge dress",
   "a": 0,
   "b": 2.8,
   "y": 1170,
   "size": 76
  },
  {
   "text": "almost never happened.",
   "a": 0,
   "b": 2.8,
   "y": 1262,
   "size": 72
  },
  {
   "text": "Serpentine Gallery, London, June 29, 1994",
   "a": 0,
   "b": 2.8,
   "y": 1350,
   "size": 42,
   "small": true
  },
  {
   "text": "She’d had it for almost",
   "a": 2.8,
   "b": 5.7,
   "y": 1170,
   "size": 74
  },
  {
   "text": "three years. Never worn.",
   "a": 2.8,
   "b": 5.7,
   "y": 1262,
   "size": 74
  },
  {
   "text": "She thought it was",
   "a": 5.7,
   "b": 8.1,
   "y": 1170,
   "size": 78
  },
  {
   "text": "too daring.",
   "a": 5.7,
   "b": 8.1,
   "y": 1262,
   "size": 78
  },
  {
   "text": "That night, she was meant",
   "a": 8.1,
   "b": 10.8,
   "y": 1170,
   "size": 68
  },
  {
   "text": "to wear Valentino.",
   "a": 8.1,
   "b": 10.8,
   "y": 1262,
   "size": 76
  },
  {
   "text": "But the fashion house",
   "a": 10.8,
   "b": 13.5,
   "y": 1170,
   "size": 76
  },
  {
   "text": "told the press first.",
   "a": 10.8,
   "b": 13.5,
   "y": 1262,
   "size": 76
  },
  {
   "text": "So she wore",
   "a": 13.5,
   "b": 16.2,
   "y": 1170,
   "size": 78
  },
  {
   "text": "the daring one.",
   "a": 13.5,
   "b": 16.2,
   "y": 1262,
   "size": 78
  },
  {
   "text": "Don’t save your best",
   "a": 16.2,
   "b": 99,
   "y": 1170,
   "size": 78
  },
  {
   "text": "for someday.",
   "a": 16.2,
   "b": 99,
   "y": 1262,
   "size": 78
  }
 ],
