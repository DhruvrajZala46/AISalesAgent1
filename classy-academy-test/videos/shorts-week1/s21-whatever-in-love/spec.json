 "texts": [
  {
   "text": "In 1981, Charles and Diana",
   "a": 0,
   "b": 2.8,
   "y": 1170,
   "size": 70
  },
  {
   "text": "announced their engagement.",
   "a": 0,
   "b": 2.8,
   "y": 1262,
   "size": 62
  },
  {
   "text": "February 24, 1981",
   "a": 0,
   "b": 2.8,
   "y": 1350,
   "size": 46,
   "small": true
  },
  {
   "text": "Asked if they were in love,",
   "a": 2.8,
   "b": 4.8,
   "y": 1215,
   "size": 70
  },
  {
   "text": "Diana: “Of course.”",
   "a": 4.8,
   "b": 6.8,
   "y": 1215,
   "size": 80
  },
  {
   "text": "Charles: “Whatever",
   "a": 6.8,
   "b": 10.0,
   "y": 1170,
   "size": 80
  },
  {
   "text": "‘in love’ means.”",
   "a": 6.8,
   "b": 10.0,
   "y": 1262,
   "size": 80
  },
  {
   "text": "Years later, she said",
   "a": 10.0,
   "b": 14.2,
   "y": 1170,
   "size": 76
  },
  {
   "text": "it traumatized her.",
   "a": 10.0,
   "b": 14.2,
   "y": 1262,
   "size": 76
  },
  {
   "text": "Love should never need",
   "a": 14.2,
